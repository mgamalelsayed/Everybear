# Production site URL — used for canonical metadata, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://everybear.net

# Connect form provider. Get an endpoint at https://formspree.io and paste here.
# When empty the form runs in dev mode (submissions are logged, no email is sent).
FORMSPREE_ENDPOINT=

# Plausible analytics. Leave both empty to disable analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=everybear.net
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
